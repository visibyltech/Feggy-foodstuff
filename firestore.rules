rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives & Hardened Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'usitakatelvin@gmail.com'
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'category', 'description', 'imageUrl',
          'isBundle', 'variants', 'minPriceNgn', 'minDailyNgn', 'minWeeklyNgn',
          'featured', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'category', 'description', 'imageUrl',
          'isBundle', 'bundleItems', 'variants', 'minPriceNgn', 'minDailyNgn',
          'minWeeklyNgn', 'featured', 'active', 'createdAt', 'updatedAt'
        ])
        && data.id == productId
        && isValidId(data.id)
        && isValidString(data.name, 2, 140)
        && isValidString(data.slug, 2, 160)
        && data.slug.matches('^[a-z0-9\\-]+$')
        && data.category in [
          'rice', 'beans', 'garri', 'palm_oil', 'groundnut_oil',
          'vegetable_oil', 'yam', 'onions', 'tomatoes',
          'pasta_noodles', 'swallow_flour', 'meat_fish', 'spices_seasoning', 'bundles'
        ]
        && isValidString(data.description, 10, 2000)
        && isValidString(data.imageUrl, 10, 600)
        && data.isBundle is bool
        && (!data.keys().hasAny(['bundleItems']) || (
          data.bundleItems is list && data.bundleItems.size() <= 15 &&
          (data.bundleItems.size() == 0 || data.bundleItems[0] is string)
        ))
        && data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 10
        && data.variants[0] is map
        && data.minPriceNgn is number && data.minPriceNgn > 0
        && data.minDailyNgn is number && data.minDailyNgn >= 500
        && data.minWeeklyNgn is number && data.minWeeklyNgn >= 5000
        && data.featured is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'smsRemindersEnabled',
          'emailRemindersEnabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'deliveryAddress',
          'city', 'state', 'smsRemindersEnabled', 'emailRemindersEnabled',
          'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isValidId(data.uid)
        && isValidString(data.email, 3, 200)
        && isValidString(data.displayName, 1, 120)
        && (!data.keys().hasAny(['phone']) || isValidString(data.phone, 0, 30))
        && (!data.keys().hasAny(['deliveryAddress']) || isValidString(data.deliveryAddress, 0, 300))
        && (!data.keys().hasAny(['city']) || isValidString(data.city, 0, 80))
        && (!data.keys().hasAny(['state']) || isValidString(data.state, 0, 80))
        && data.smsRemindersEnabled is bool
        && data.emailRemindersEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid == adminId
        && isValidId(data.uid)
        && isValidString(data.email, 3, 200)
        && data.role in ['admin', 'super_admin']
        && data.createdAt is timestamp;
    }

    function isValidInstallmentPlan(data, planId) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'customerEmail', 'reminderPhone',
          'productId', 'productName', 'variantLabel', 'productImageUrl',
          'frequency', 'installmentAmountNgn', 'totalTargetNgn',
          'amountPaidNgn', 'outstandingBalanceNgn', 'contributionsCount',
          'totalInstallments', 'status', 'deliveryAddress',
          'nextDueDate', 'expectedCompletionDate', 'lastPaymentReference',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'reminderPhone',
          'productId', 'productName', 'variantLabel', 'productImageUrl',
          'frequency', 'installmentAmountNgn', 'totalTargetNgn',
          'amountPaidNgn', 'outstandingBalanceNgn', 'contributionsCount',
          'totalInstallments', 'status', 'deliveryAddress',
          'nextDueDate', 'expectedCompletionDate', 'lastPaymentReference',
          'createdAt', 'updatedAt'
        ])
        && data.id == planId
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidString(data.customerName, 1, 120)
        && isValidString(data.customerEmail, 3, 200)
        && isValidString(data.reminderPhone, 7, 30)
        && isValidId(data.productId)
        && isValidString(data.productName, 1, 160)
        && isValidString(data.variantLabel, 1, 60)
        && isValidString(data.productImageUrl, 1, 600)
        && data.frequency in ['daily', 'weekly', 'monthly']
        && data.installmentAmountNgn is number
        && (
          (data.frequency == 'daily' && data.installmentAmountNgn >= 500) ||
          (data.frequency == 'weekly' && data.installmentAmountNgn >= 5000) ||
          (data.frequency == 'monthly' && data.installmentAmountNgn >= 1000)
        )
        && data.totalTargetNgn is number && data.totalTargetNgn > 0
        && data.amountPaidNgn is number && data.amountPaidNgn > 0 && data.amountPaidNgn <= data.totalTargetNgn
        && data.outstandingBalanceNgn is number && data.outstandingBalanceNgn >= 0
        && data.outstandingBalanceNgn == data.totalTargetNgn - data.amountPaidNgn
        && data.contributionsCount is number && data.contributionsCount >= 1
        && data.totalInstallments is number && data.totalInstallments >= 1
        && data.status in ['active', 'completed', 'ready_for_delivery', 'delivered', 'cancelled']
        && (
          (data.status == 'active' && data.amountPaidNgn < data.totalTargetNgn) ||
          (data.status in ['completed', 'ready_for_delivery', 'delivered'] && data.amountPaidNgn == data.totalTargetNgn) ||
          data.status == 'cancelled'
        )
        && isValidString(data.deliveryAddress, 5, 300)
        && isValidString(data.nextDueDate, 4, 40)
        && isValidString(data.expectedCompletionDate, 4, 40)
        && isValidString(data.lastPaymentReference, 4, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'purchaseMode', 'items', 'totalAmountNgn', 'paystackReference',
          'paymentStatus', 'deliveryStatus', 'deliveryAddress',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'purchaseMode', 'items', 'totalAmountNgn', 'paystackReference',
          'paymentStatus', 'deliveryStatus', 'deliveryAddress',
          'trackingNote', 'subscriptionId', 'createdAt', 'updatedAt'
        ])
        && data.id == orderId
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidString(data.customerName, 1, 120)
        && isValidString(data.customerEmail, 3, 200)
        && isValidString(data.customerPhone, 7, 30)
        && data.purchaseMode in ['buy_now', 'pay_small_small_completed', 'subscription_renewal']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.items[0] is map
        && data.totalAmountNgn is number && data.totalAmountNgn > 0
        && isValidString(data.paystackReference, 4, 128)
        && data.paymentStatus == 'paid'
        && data.deliveryStatus in ['processing', 'packed', 'out_for_delivery', 'delivered']
        && isValidString(data.deliveryAddress, 5, 300)
        && (!data.keys().hasAny(['trackingNote']) || isValidString(data.trackingNote, 0, 300))
        && (!data.keys().hasAny(['subscriptionId']) || isValidString(data.subscriptionId, 0, 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data, paymentId) {
      return data.keys().hasAll([
          'id', 'userId', 'customerEmail', 'customerName', 'paystackReference',
          'purpose', 'amountNgn', 'currency', 'channel', 'gatewayStatus',
          'receiptNumber', 'description', 'paidAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerEmail', 'customerName', 'paystackReference',
          'purpose', 'relatedPlanId', 'relatedOrderId', 'amountNgn', 'currency',
          'channel', 'gatewayStatus', 'receiptNumber', 'description', 'paidAt',
          'createdAt'
        ])
        && data.id == paymentId
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidString(data.customerEmail, 3, 200)
        && isValidString(data.customerName, 1, 120)
        && isValidId(data.paystackReference)
        && data.purpose in ['buy_now', 'installment_start', 'installment_contribution', 'subscription_renewal']
        && (!data.keys().hasAny(['relatedPlanId']) || isValidString(data.relatedPlanId, 0, 128))
        && (!data.keys().hasAny(['relatedOrderId']) || isValidString(data.relatedOrderId, 0, 128))
        && data.amountNgn is number && data.amountNgn > 0
        && data.currency == 'NGN'
        && isValidString(data.channel, 1, 40)
        && data.gatewayStatus == 'success'
        && isValidString(data.receiptNumber, 4, 60)
        && isValidString(data.description, 2, 240)
        && isValidString(data.paidAt, 4, 60)
        && data.createdAt is timestamp;
    }

    function isValidSubscription(data, subId) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'productId', 'bundleTitle', 'variantLabel', 'imageUrl', 'priceNgn',
          'cadence', 'status', 'deliveryAddress', 'nextBillingDate',
          'lastPaymentReference', 'renewalsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'productId', 'bundleTitle', 'variantLabel', 'imageUrl', 'priceNgn',
          'cadence', 'status', 'deliveryAddress', 'nextBillingDate',
          'lastPaymentReference', 'renewalsCount', 'createdAt', 'updatedAt'
        ])
        && data.id == subId
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidString(data.customerName, 1, 120)
        && isValidString(data.customerEmail, 3, 200)
        && isValidString(data.customerPhone, 7, 30)
        && isValidId(data.productId)
        && isValidString(data.bundleTitle, 2, 160)
        && isValidString(data.variantLabel, 1, 60)
        && isValidString(data.imageUrl, 1, 600)
        && data.priceNgn is number && data.priceNgn > 0
        && data.cadence == 'monthly'
        && data.status in ['active', 'paused', 'cancelled']
        && isValidString(data.deliveryAddress, 5, 300)
        && isValidString(data.nextBillingDate, 4, 40)
        && isValidString(data.lastPaymentReference, 4, 128)
        && data.renewalsCount is number && data.renewalsCount >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReminderLog(data, logId) {
      return data.keys().hasAll([
          'id', 'userId', 'planId', 'channel', 'frequency',
          'recipient', 'status', 'message', 'sentAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'planId', 'channel', 'frequency',
          'recipient', 'status', 'message', 'sentAt'
        ])
        && data.id == logId
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.planId)
        && data.channel in ['sms', 'email']
        && data.frequency in ['daily', 'weekly', 'monthly']
        && isValidString(data.recipient, 3, 200)
        && data.status in ['sent', 'failed', 'queued']
        && isValidString(data.message, 5, 500)
        && data.sentAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------------------

    // Startup connection check document
    match /test/connection {
      allow get: if true;
    }

    // Public catalog, Admin-only writes
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Customer private profile (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'deliveryAddress', 'city', 'state',
          'smsRemindersEnabled', 'emailRemindersEnabled', 'updatedAt'
        ]));
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admin role directory
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminId)
        && isValidAdminRecord(incoming(), adminId);
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // Pay Small Small Installment Plans
    match /installmentPlans/{planId} {
      allow get: if isValidId(planId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(planId)
        && isValidInstallmentPlan(incoming(), planId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isVerifiedUser() && isValidId(planId)
        && isValidInstallmentPlan(incoming(), planId)
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().totalTargetNgn == existing().totalTargetNgn
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && !(existing().status in ['delivered', 'cancelled'])
            && (
              (
                incoming().amountPaidNgn > existing().amountPaidNgn
                && incoming().contributionsCount == existing().contributionsCount + 1
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'amountPaidNgn', 'outstandingBalanceNgn', 'contributionsCount',
                  'status', 'nextDueDate', 'lastPaymentReference', 'updatedAt'
                ])
              ) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'reminderPhone', 'deliveryAddress', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(planId);
    }

    // Verified Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(orderId)
        && isValidOrder(incoming(), orderId)
        && incoming().userId == request.auth.uid
        && incoming().deliveryStatus == 'processing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(orderId)
        && isValidOrder(incoming(), orderId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Immutable Payment Ledger & Receipts
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(paymentId)
        && isValidPaymentRecord(incoming(), paymentId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(paymentId);
    }

    // Monthly Food Subscriptions
    match /subscriptions/{subId} {
      allow get: if isValidId(subId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(subId)
        && isValidSubscription(incoming(), subId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(subId)
        && isValidSubscription(incoming(), subId)
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().priceNgn == existing().priceNgn
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'deliveryAddress', 'updatedAt'
              ]) ||
              (
                incoming().renewalsCount == existing().renewalsCount + 1
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'nextBillingDate', 'lastPaymentReference', 'renewalsCount', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(subId);
    }

    // SMS & Email Reminder Logs
    match /reminderLogs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(logId)
        && isValidReminderLog(incoming(), logId);
      allow delete: if isAdmin() && isValidId(logId);
    }
  }
}
