          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bundleTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "variantLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "priceNgn": {
          "type": "number"
        },
        "cadence": {
          "type": "string",
          "enum": ["monthly"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "cancelled"]
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "nextBillingDate": {
          "type": "string",
          "maxLength": 40
        },
        "lastPaymentReference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "renewalsCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "productId",
        "bundleTitle",
        "variantLabel",
        "imageUrl",
        "priceNgn",
        "cadence",
        "status",
        "deliveryAddress",
        "nextBillingDate",
        "lastPaymentReference",
        "renewalsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReminderLog": {
      "title": "ReminderLog",
      "description": "SMS and Email installment reminder dispatch audit log",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "channel": {
          "type": "string",
          "enum": ["sms", "email"]
        },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly"]
        },
        "recipient": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["sent", "failed", "queued"]
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "planId",
        "channel",
        "frequency",
        "recipient",
        "status",
        "message",
        "sentAt"
      ]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable catalog of Nigerian foodstuffs and ready-made food bundles; admin-only writes"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile containing PII and reminder opt-ins; restricted to owner and admin"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role directory"
    },
    "/installmentPlans/{planId}": {
      "schema": { "$ref": "#/entities/InstallmentPlan" },
      "description": "Customer Pay Small Small installment plans"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Verified customer orders and delivery statuses"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Immutable verified Paystack transaction records and receipts"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Monthly food bundle subscriptions"
    },
    "/reminderLogs/{logId}": {
      "schema": { "$ref": "#/entities/ReminderLog" },
      "description": "Automated SMS and email reminder logs"
    }
  }
}
